generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Preorder {
  id               Int      @id @default(autoincrement())
  order_date       DateTime
  order_by         Int
  selected_package Int
  qty              Int
  is_paid          Boolean
  
  Pkg  Pkg         @relation(fields: [selected_package], references: [id])
  customer         customer @relation(fields: [order_by], references: [id])
} 

model Pkg {
  id               Int      @id @default(autoincrement())
  kode             String   @unique
  nama             String
  deskripsi        String
  Preorders        Preorder[]
} 

model customer {
  id               Int      @id @default(autoincrement())
  name             String   
  phone            String
  email            String?
  createdAt DateTime @default(now())
  Preorders        Preorder[]
} 