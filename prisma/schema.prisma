generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Preorder {
  id               Int      @id @default(autoincrement())
  order_date       DateTime
  order_by         String
  selected_package String
  qty              Int
  is_paid          Boolean
} 

model Pkg {
  id               Int      @id @default(autoincrement())
  kode             String   @unique
  nama             String
  deskripsi        String
} 

model customer {
  id               Int      @id @default(autoincrement())
  name             String   
  phone            String
  email            String?
  createdAt DateTime @default(now()) 
} 